# Copy to .env and replace the placeholder with your development database URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
SCHEDULER_TIMEZONE=Asia/Kolkata

# Optional scraper settings (application defaults)
SCRAPER_MAX_CHARS=6000
SCRAPER_TIMEOUT_CONNECT=10
SCRAPER_TIMEOUT_READ=20
SCRAPER_MAX_RETRIES=2
SCRAPER_POLITENESS_DELAY=1.0
SCRAPER_ROBOTS_CACHE_TTL_SECONDS=86400

# Set TEST_DATABASE_URL separately only for a disposable test database.
# Never use the production or populated demo database for integration tests.
